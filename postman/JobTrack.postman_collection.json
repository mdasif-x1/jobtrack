    {
      "name": "Applications",
      "item": [
        {
          "name": "Create Application",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"jobRole\": \"Backend Software Engineer Intern\",\n  \"jobType\": \"INTERNSHIP\",\n  \"status\": \"APPLIED\",\n  \"applicationDate\": \"2026-09-12\",\n  \"jobLink\": \"https://example.com/jobs/backend-intern-postman\",\n  \"location\": \"Bengaluru\",\n  \"notes\": \"Postman collection sample\",\n  \"nextActionDate\": \"2026-09-20\",\n  \"companyId\": 4\n}"},
            "url": "{{baseUrl}}/api/applications"
          }
        },
        {"name": "Get All Applications", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications"}},
        {"name": "Get Application by ID", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/4"}},
        {
          "name": "Update Application",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"jobRole\": \"Backend Software Engineer Intern - Updated\",\n  \"jobType\": \"INTERNSHIP\",\n  \"status\": \"APPLIED\",\n  \"applicationDate\": \"2026-09-09\",\n  \"jobLink\": \"https://jobs.atlassian.com/verification-backend-intern-01\",\n  \"location\": \"Noida\",\n  \"notes\": \"Updated through Postman\",\n  \"nextActionDate\": \"2026-09-21\",\n  \"companyId\": 3\n}"},
            "url": "{{baseUrl}}/api/applications/4"
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"INTERVIEW\"\n}"},
            "url": "{{baseUrl}}/api/applications/4/status"
          }
        },
        {"name": "Delete Application", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/applications/6"}}
      ]
    },
    {
      "name": "Search and Filters",
      "item": [
        {"name": "Search Applications - Role", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/search?keyword=java"}},
        {"name": "Search Applications - Company", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/search?keyword=ATLAS"}},
