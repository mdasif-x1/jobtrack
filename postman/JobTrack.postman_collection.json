        {"name": "Filter Applications - Invalid Date Range", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/filter/date?startDate=2026-09-12&endDate=2026-09-09"}},
        {"name": "Filter Applications - Missing End Date", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/filter/date?startDate=2026-09-09"}},
