      "item": [
        {
          "name": "Create Company",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Atlassian\",\n  \"website\": \"https://www.atlassian.com\",\n  \"location\": \"Bengaluru\"\n}"},
            "url": "{{baseUrl}}/api/companies"
          }
        },
        {"name": "Get All Companies", "request": {"method": "GET", "url": "{{baseUrl}}/api/companies"}},
        {"name": "Get Company by ID", "request": {"method": "GET", "url": "{{baseUrl}}/api/companies/4"}},
        {
          "name": "Update Company",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Atlassian Updated\",\n  \"website\": \"https://www.atlassian.com/careers\",\n  \"location\": \"Noida\"\n}"},
            "url": "{{baseUrl}}/api/companies/4"
          }
        },
        {"name": "Delete Company", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/companies/7"}}
