        {"name": "Search Applications - Paginated", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/search?keyword=engineer&page=0&size=1&sort=jobRole,asc"}},
        {"name": "Filter Applications - Status", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/filter/status?status=SAVED"}},
        {"name": "Filter Applications - Job Type", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/filter/job-type?jobType=INTERNSHIP"}},
        {"name": "Filter Applications - Date Range", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/filter/date?startDate=2026-09-09&endDate=2026-09-12"}},
        {"name": "Get Upcoming Actions", "request": {"method": "GET", "url": "{{baseUrl}}/api/applications/upcoming"}},
